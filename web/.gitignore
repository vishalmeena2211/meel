*.tsbuildinfo
next-env.d.ts

# copied in from ../data by scripts/sync-data.mjs
/content/
/public/route-images/

# accounts, trips and reports live here
/.data/

# Prisma client, made by `prisma generate` from prisma/schema.prisma
/src/generated/
