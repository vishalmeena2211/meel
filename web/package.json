{
  "name": "meel-web",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "scripts": {
    "sync-data": "node scripts/sync-data.mjs",
    "postinstall": "prisma generate --no-hints",
    "predev": "prisma generate --no-hints && node scripts/sync-data.mjs",
    "dev": "next dev",
    "prebuild": "prisma generate --no-hints && node scripts/sync-data.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "prisma generate --no-hints && next typegen && tsc --noEmit",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "ask:index": "tsx scripts/ask-index.mts",
    "ask:try": "tsx --conditions=react-server --require ./scripts/ask-try-preload.cjs scripts/ask-try.mts",
    "ask:warm": "tsx --conditions=react-server --require ./scripts/ask-try-preload.cjs scripts/ask-warm.mts"
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "@vercel/analytics": "2.0.1",
    "@vercel/oidc": "4.0.1",
    "google-auth-library": "11.3.1",
    "mixpanel-browser": "2.83.0",
    "next": "16.3.6",
    "next-auth": "5.0.0-beta.32",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^24.19.0",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prisma": "7.10.0",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5"
  },
  "packageManager": "pnpm@9.15.4",
  "pnpm": {
    "overrides": {
      "mysql2": "^3.24.5",
      "source-map-js": "^1.2.2",
      "deepmerge-ts": "^8.0.2"
    }
  }
}
